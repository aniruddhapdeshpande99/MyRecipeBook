---
// Footer.astro
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" aria-hidden="true" style="width:28px;height:28px;color:var(--color-sage-light)">
        <!-- Knife (Option A style) -->
        <path d="M12 36 L24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M24 24 Q32 16 38 12 L40 14 Q36 20 28 28 Z" fill="currentColor" opacity="0.85"/>
        <!-- Pot (Option A style) -->
        <rect x="14" y="24" width="20" height="14" rx="3" stroke="currentColor" stroke-width="2.5" fill="none"/>
        <path d="M11 27 L14 27" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M34 27 L37 27" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M20 24 C20 20, 28 20, 28 24" stroke="currentColor" stroke-width="2.5" fill="none"/>
      </svg>
      <span class="site-footer__name">Sven's Cookbook</span>
      <p class="site-footer__tagline">A personal collection of recipes, crafted with care.</p>
    </div>
    <nav class="site-footer__nav" aria-label="Footer navigation">
      <a href="/">Recipes</a>
      <a href="/editor">+ Add Recipe</a>
      <a href="/legal">Legal</a>
    </nav>
    <p class="site-footer__copy">
      &copy; <span id="footer-year"></span> Sven's Cookbook. All rights reserved.
    </p>
  </div>
</footer>
<script>
  const el = document.getElementById('footer-year');
  if (el) el.textContent = String(new Date().getFullYear());
</script>
