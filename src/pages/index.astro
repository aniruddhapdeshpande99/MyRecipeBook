---
import Layout from '../layouts/Layout.astro';
import { parseRecipe } from '../utils/recipeParser';
import { promises as fs } from 'node:fs';
import path from 'node:path';

const dataDir = path.join(process.cwd(), 'data', 'recipes');
let recipes: any[] = [];

async function getMarkdownFiles(dir: string): Promise<string[]> {
  const dirents = await fs.readdir(dir, { withFileTypes: true });
  const files = await Promise.all(dirents.map((dirent) => {
    const res = path.resolve(dir, dirent.name);
    return dirent.isDirectory() ? getMarkdownFiles(res) : res;
  }));
  return Array.prototype.concat(...files).filter(f => f.endsWith('.md'));
}

try {
  const filePaths = await getMarkdownFiles(dataDir);
  const parsedPromises = filePaths.map(async (filePath) => {
    const rawContent = await fs.readFile(filePath, 'utf-8');
    return parseRecipe(filePath, rawContent);
  });
  recipes = await Promise.all(parsedPromises);
} catch (e) {
  // Directory might not exist yet or be empty
}

const groupedRecipes: Record<string, typeof recipes> = {};
recipes.forEach((recipe) => {
  const cat = recipe.category || 'Other';
  if (!groupedRecipes[cat]) groupedRecipes[cat] = [];
  groupedRecipes[cat].push(recipe);
});

const sortedCategories = Object.keys(groupedRecipes).sort();
sortedCategories.forEach((category) => {
  groupedRecipes[category].sort((a, b) => a.title.localeCompare(b.title));
});
---

<Layout title="Home" description="A personal collection of recipes, crafted for cooking.">

  <!-- Hero Banner -->
  <div class="hero-banner">
    <img
      src="/images/hero-banner.jpg"
      alt="A warm, cozy kitchen with sage green cabinets"
      class="hero-banner__img"
    />
    <div class="hero-banner__overlay"></div>
    <div class="hero-banner__content">
      <h1 class="hero-banner__title">Sven's Cookbook</h1>
      <p class="hero-banner__subtitle">A personal collection of recipes, crafted with care.</p>
    </div>
  </div>

  <main>
    <!-- Search -->
    <div class="search-container">
      <input
        type="text"
        id="search-bar"
        class="search-input"
        placeholder="Search recipes or ingredients..."
        aria-label="Search recipes"
      />
    </div>

    <!-- Recipe List -->
    <div id="recipe-list">
      {sortedCategories.map((category) => (
        <section class="category-section" data-category={category}>
          <h2 class="category-title">{category}</h2>
          <div class="recipe-grid">
            {groupedRecipes[category].map((recipe) => (
              <a
                href={`/recipes/${recipe.slug}`}
                class="recipe-card"
                data-title={recipe.title.toLowerCase()}
                data-desc={(recipe.description || '').toLowerCase()}
              >
                <span class="recipe-card__badge">{category}</span>
                <div class="recipe-card__body">
                  <h3>{recipe.title}</h3>
                  <p class="desc">{recipe.description}</p>
                  <div class="recipe-meta-inline">
                    {recipe.prepTime && recipe.prepTime !== 'N/A' && (
                      <span>⏱ {recipe.prepTime}</span>
                    )}
                    {recipe.cookTime && recipe.cookTime !== 'N/A' && (
                      <span>🍳 {recipe.cookTime}</span>
                    )}
                    {recipe.yieldVal && recipe.yieldVal !== 'N/A' && (
                      <span>🍽 {recipe.yieldVal}</span>
                    )}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    <div id="no-results" style="display:none; text-align:center; margin:3rem 0; font-family:var(--font-serif); font-size:1.2rem; color:var(--color-muted); font-style:italic;">
      No recipes match your search.
    </div>
  </main>

  <script>
    const searchBar = document.getElementById('search-bar') as HTMLInputElement;
    const categorySections = document.querySelectorAll('.category-section');
    const noResults = document.getElementById('no-results') as HTMLDivElement;

    if (searchBar) {
      searchBar.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
        let totalVisible = 0;

        categorySections.forEach((section) => {
          const cards = section.querySelectorAll('.recipe-card');
          let visible = 0;
          cards.forEach((card) => {
            const title = card.getAttribute('data-title') || '';
            const desc = card.getAttribute('data-desc') || '';
            const match = !query || title.includes(query) || desc.includes(query);
            (card as HTMLElement).style.display = match ? 'flex' : 'none';
            if (match) visible++;
          });
          (section as HTMLElement).style.display = visible === 0 ? 'none' : 'block';
          totalVisible += visible;
        });

        noResults.style.display = totalVisible === 0 ? 'block' : 'none';
      });
    }
  </script>
</Layout>
