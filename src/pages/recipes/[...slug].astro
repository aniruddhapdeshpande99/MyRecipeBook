---
// @ts-nocheck
import Layout from '../../layouts/Layout.astro';
import { parseRecipe } from '../../utils/recipeParser';
import { sanitiseSlug } from '../../utils/slugUtils';
import fsPromises from 'node:fs/promises';
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';

const { slug } = Astro.params;

// Sanitise slug: strip everything except alphanumeric, hyphens, underscores.
// This prevents directory traversal (no ../ or slashes allowed through).
const safeSlug = sanitiseSlug(slug ?? '');
if (!safeSlug) {
  return Astro.redirect('/404');
}

const dataDir = path.join(process.cwd(), 'data', 'recipes');
const filePath = path.join(dataDir, `${safeSlug}.md`);

let rawContent = '';
try {
  rawContent = await fsPromises.readFile(filePath, 'utf-8');
} catch {
  return Astro.redirect('/404');
}

const recipe: any = parseRecipe(filePath, rawContent);
const htmlContent = marked.parse(recipe.content || rawContent);

const imageBasename = safeSlug;
const publicImagePath = path.join(process.cwd(), 'public', 'images', `${imageBasename}.jpg`);
const hasImage = fs.existsSync(publicImagePath);
const imagePath = recipe.imageUrl || (hasImage ? `/images/${imageBasename}.jpg` : null);

const hasPrep = recipe.prepTime && recipe.prepTime !== 'N/A';
const hasCook = recipe.cookTime && recipe.cookTime !== 'N/A';
const hasYield = recipe.yieldVal && recipe.yieldVal !== 'N/A';
const hasAnyMeta = hasPrep || hasCook || hasYield;

const diaryFilePath = path.join(process.cwd(), 'data', 'diary', `${safeSlug}.json`);
let diaryEntries = [];
try {
  const diaryRaw = await fsPromises.readFile(diaryFilePath, 'utf-8');
  diaryEntries = JSON.parse(diaryRaw);
} catch {
  // Diary doesn't exist yet
}
---

<Layout title={recipe.title} description={recipe.description}>
  <main data-recipe-slug={safeSlug}>
    <div class="recipe-detail">

      <!-- Back link -->
      <a href="/" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        All Recipes
      </a>

      <!-- Header -->
      <div class="recipe-detail-header">
        <h1>{recipe.title}</h1>
        <p class="recipe-description">{recipe.description}</p>

        <!-- Action Buttons -->
        <div class="recipe-actions">
          <button id="toggle-cooking" class="action-btn" title="Toggle cooking mode">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            Start Cooking
          </button>
          <a href={`/editor?slug=${safeSlug}`} class="action-btn" title="Edit this recipe">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
            Edit Recipe
          </a>
          <button onclick="window.print()" class="action-btn" title="Print recipe">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 6 2 18 2 18 9"/>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
              <rect x="6" y="14" width="12" height="8"/>
            </svg>
            Print
          </button>
        </div>

        <!-- Metadata Box — only shown if any value exists -->
        {hasAnyMeta && (
          <div class="metadata-box">
            {hasPrep && (
              <div class="meta-item">
                <span class="meta-label">Prep</span>
                <span class="meta-value">{recipe.prepTime}</span>
              </div>
            )}
            {hasCook && (
              <div class="meta-item">
                <span class="meta-label">Cook</span>
                <span class="meta-value">{recipe.cookTime}</span>
              </div>
            )}
            {hasYield && (
              <div class="meta-item">
                <span class="meta-label">Yield</span>
                <span class="meta-value">{recipe.yieldVal}</span>
              </div>
            )}
          </div>
        )}
      </div>

      <!-- Hero Image -->
      {imagePath && (
        <img src={imagePath} alt={recipe.title} class="recipe-hero-image" />
      )}

      <!-- Structured Two-Column Layout (built by JS) -->
      <div class="recipe-columns" id="structured-layout" style="display:none;">
        <div id="ingredients-col">
          <h2 style="font-family:var(--font-serif); font-size:1.3rem; margin-bottom:1rem; color:var(--color-ink);">Ingredients</h2>
          <div class="section-divider"><span>✦</span></div>
        </div>
        <div id="instructions-col">
          <h2 style="font-family:var(--font-serif); font-size:1.3rem; margin-bottom:1rem; color:var(--color-ink);">Instructions</h2>
          <div class="section-divider"><span>✦</span></div>
        </div>
      </div>

      <!-- Cooking Progress Bar -->
      <div class="cooking-progress" id="cooking-progress">
        <div class="cooking-progress__bar">
          <div class="cooking-progress__fill" id="progress-fill"></div>
        </div>
        <span class="cooking-progress__label" id="progress-label">0 / 0 steps</span>
      </div>

      <!-- Step navigation removed. Now handled inline per step -->

      <!-- Notes accordion (built by JS) -->
      <div id="notes-col" class="notes-section" style="display:none;"></div>

      <!-- Cooking Diary section -->
      <div class="diary-gallery-section">
        <h2 class="diary-gallery-title">Cooking Diary ✦</h2>
        {diaryEntries.length === 0 ? (
          <p style="color: var(--color-muted); font-style: italic; margin-bottom: 2rem;">No diary entries yet. Complete cooking mode to log your first masterpiece!</p>
        ) : (
          <div class="diary-grid" id="diary-entries-container" style="margin-bottom: 2rem;">
            {diaryEntries.map((entry: any) => {
              const formattedDate = new Date(entry.date).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              });
              return (
                <div class="diary-card">
                  <img src={entry.imagePath} alt={entry.caption || "Diary Entry"} class="diary-card-img" />
                  <div class="diary-card-body">
                    <span class="diary-card-date">{formattedDate}</span>
                    {entry.caption && <p class="diary-card-caption">{entry.caption}</p>}
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>

      <!-- Diary Modal Overlay -->
      <div id="diary-modal" class="diary-modal-overlay" style="display: none;">
        <div class="diary-modal-card">
          <button id="diary-modal-close" class="diary-close-btn" aria-label="Close modal">✕</button>
          <h2 class="diary-modal-title">Cooked it! ✦</h2>
          <p class="diary-modal-subtitle">Save a photo of your masterpiece to your cooking diary?</p>
          
          <form id="diary-form" class="diary-modal-form">
            <div class="diary-form-group">
              <label>Upload Photo *</label>
              <div id="diary-upload-zone" class="diary-upload-zone">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-sage)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="17 8 12 3 7 8"/>
                  <line x1="12" y1="3" x2="12" y2="15"/>
                </svg>
                <span id="diary-upload-label">Click to select photo</span>
                <input type="file" id="diary-photo" accept="image/*" required style="display: none;" />
              </div>
              <div id="diary-preview-container" class="diary-preview-container" style="display: none;">
                <img id="diary-photo-preview" src="" alt="Preview" />
                <button type="button" id="diary-remove-photo" class="diary-remove-photo-btn">✕</button>
              </div>
            </div>
            
            <div class="diary-form-group">
              <label for="diary-caption">Caption</label>
              <input type="text" id="diary-caption" placeholder="How did it turn out? (e.g. Deliciously spicy!)" />
            </div>
            
            <div class="diary-modal-actions">
              <button type="button" id="diary-cancel-btn" class="diary-btn diary-btn--secondary">Cancel</button>
              <button type="submit" id="diary-submit-btn" class="diary-btn diary-btn--primary">Save Entry</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Fallback raw render -->
      <div id="raw-render" set:html={htmlContent}></div>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const rawRender = document.getElementById('raw-render');
      const structuredLayout = document.getElementById('structured-layout');
      const ingredientsCol = document.getElementById('ingredients-col');
      const instructionsCol = document.getElementById('instructions-col');
      const notesCol = document.getElementById('notes-col');

      if (!rawRender || !structuredLayout || !ingredientsCol || !instructionsCol) return;

      const children = Array.from(rawRender.children);
      let currentTarget: HTMLElement | null = null;
      let skipFirstH1 = true;
      let skipDescription = true;
      let inNotes = false;

      children.forEach((child) => {
        const tag = child.tagName;
        const text = (child.textContent || '').toLowerCase().trim();

        if (tag === 'H1' && skipFirstH1) { skipFirstH1 = false; return; }
        if (tag === 'P' && skipDescription && !skipFirstH1) { skipDescription = false; return; }

        if (currentTarget === null) {
          if (tag === 'HR' || text.includes('prep time') || text.includes('cook time') || text.includes('yield')) return;
        }

        if (tag === 'H3') {
          if (currentTarget === ingredientsCol) {
            const subheading = document.createElement('h3');
            subheading.className = 'recipe-subheading';
            subheading.style.cssText = 'font-family:var(--font-serif); font-size:1.15rem; margin:1.75rem 0 0.75rem 0; color:var(--color-terracotta); font-weight:600; border-bottom:1px dashed rgba(140,59,26,0.2); padding-bottom:0.25rem;';
            subheading.textContent = child.textContent || '';
            ingredientsCol.appendChild(subheading);
            return;
          }
        }

        if (tag === 'H2') {
          if (text.includes('ingredient')) { currentTarget = ingredientsCol; inNotes = false; return; }
          if (text.includes('step') || text.includes('instruction') || text.includes('method')) { currentTarget = instructionsCol; inNotes = false; return; }
          if (text.includes('note') || text.includes('tip') || text.includes('origin') || text.includes('based on')) {
            currentTarget = notesCol;
            inNotes = true;
            if (notesCol) {
              notesCol.style.display = 'block';
              const heading = document.createElement('h2');
              heading.style.cssText = 'font-family:var(--font-serif);font-size:1.3rem;margin-bottom:1rem;color:var(--color-ink);';
              heading.textContent = child.textContent || 'Notes';
              notesCol.appendChild(heading);
              const divider = document.createElement('div');
              divider.className = 'section-divider';
              divider.innerHTML = '<span>✦</span>';
              notesCol.appendChild(divider);
            }
            return;
          }
          currentTarget = instructionsCol;
          inNotes = false;
        }

        if (!currentTarget) return;

        if (tag === 'UL' && !inNotes) {
          // Ingredients — add checkbox UI
          const ul = document.createElement('ul');
          ul.className = 'ingredients-list';
          Array.from(child.children).forEach((li) => {
            const newLi = document.createElement('li');
            const check = document.createElement('span');
            check.className = 'ingredient-check';
            check.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
            const textSpan = document.createElement('span');
            textSpan.textContent = li.textContent || '';
            newLi.appendChild(check);
            newLi.appendChild(textSpan);
            newLi.addEventListener('click', () => newLi.classList.toggle('checked'));
            ul.appendChild(newLi);
          });
          ingredientsCol.appendChild(ul);
        } else if (tag === 'OL' && !inNotes) {
          // Steps — numbered circles
          const ol = document.createElement('ol');
          ol.className = 'instructions-list';
          let stepIndex = 0;
          Array.from(child.children).forEach((li) => {
            stepIndex++;
            const newLi = document.createElement('li');
            newLi.className = 'interactive-step';
            const circle = document.createElement('span');
            circle.className = 'step-circle';
            circle.textContent = String(stepIndex);
            const textSpan = document.createElement('span');
            textSpan.style.flex = '1';
            textSpan.textContent = li.textContent || '';
            newLi.appendChild(circle);
            newLi.appendChild(textSpan);
            ol.appendChild(newLi);
          });
          instructionsCol.appendChild(ol);
        } else if (inNotes && notesCol) {
          // Notes — accordion items
          if (tag === 'UL' || tag === 'OL') {
            Array.from(child.children).forEach((li) => {
              const item = document.createElement('div');
              item.className = 'accordion-item';
              const trigger = document.createElement('button');
              trigger.className = 'accordion-trigger';
              const preview = (li.textContent || '').slice(0, 80) + ((li.textContent || '').length > 80 ? '…' : '');
              trigger.innerHTML = `<span>${preview}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>`;
              const body = document.createElement('div');
              body.className = 'accordion-body';
              body.textContent = li.textContent || '';
              trigger.addEventListener('click', () => item.classList.toggle('open'));
              item.appendChild(trigger);
              item.appendChild(body);
              notesCol.appendChild(item);
            });
          } else {
            // Plain paragraph notes
            const item = document.createElement('div');
            item.className = 'accordion-item';
            const trigger = document.createElement('button');
            trigger.className = 'accordion-trigger';
            const textPreview = (child.textContent || '').slice(0, 80) + ((child.textContent || '').length > 80 ? '…' : '');
            trigger.innerHTML = `<span>${textPreview}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>`;
            const body = document.createElement('div');
            body.className = 'accordion-body';
            body.textContent = child.textContent || '';
            trigger.addEventListener('click', () => item.classList.toggle('open'));
            item.appendChild(trigger);
            item.appendChild(body);
            notesCol.appendChild(item);
          }
        } else {
          currentTarget.appendChild(child.cloneNode(true));
        }
      });

      rawRender.style.display = 'none';
      structuredLayout.style.display = 'grid';

      // === COOKING MODE ===
      const toggleBtn = document.getElementById('toggle-cooking');
      const progressFill = document.getElementById('progress-fill') as HTMLElement;
      const progressLabel = document.getElementById('progress-label');

      const allSteps = instructionsCol.querySelectorAll('.interactive-step');
      const totalSteps = allSteps.length;

      function updateProgress() {
        const done = instructionsCol ? instructionsCol.querySelectorAll('.interactive-step.completed').length : 0;
        const pct = totalSteps > 0 ? (done / totalSteps) * 100 : 0;
        if (progressFill) progressFill.style.width = pct + '%';
        if (progressLabel) progressLabel.textContent = `${done} / ${totalSteps} steps`;
      }

      allSteps.forEach((step, idx) => {
        step.addEventListener('click', () => {
          if (!document.body.classList.contains('cooking-mode-active')) return;
          goToStep(idx);
        });
      });

      // === DIARY MODAL LOGIC ===
      const diaryModal = document.getElementById('diary-modal');
      const diaryModalClose = document.getElementById('diary-modal-close');
      const diaryCancelBtn = document.getElementById('diary-cancel-btn');
      const diaryForm = document.getElementById('diary-form') as HTMLFormElement;
      const diaryUploadZone = document.getElementById('diary-upload-zone');
      const diaryPhotoInput = document.getElementById('diary-photo') as HTMLInputElement;
      const diaryPreviewContainer = document.getElementById('diary-preview-container');
      const diaryPhotoPreview = document.getElementById('diary-photo-preview') as HTMLImageElement;
      const diaryRemovePhoto = document.getElementById('diary-remove-photo');
      const diaryUploadLabel = document.getElementById('diary-upload-label');

      function openDiaryModal() {
        if (diaryModal) diaryModal.style.display = 'flex';
      }

      function closeDiaryModal() {
        if (diaryModal) diaryModal.style.display = 'none';
        if (diaryForm) diaryForm.reset();
        if (diaryPreviewContainer) diaryPreviewContainer.style.display = 'none';
        if (diaryUploadZone) diaryUploadZone.style.display = 'flex';
        if (diaryUploadLabel) diaryUploadLabel.textContent = 'Click to select photo';
      }

      if (diaryModalClose) diaryModalClose.addEventListener('click', closeDiaryModal);
      if (diaryCancelBtn) diaryCancelBtn.addEventListener('click', closeDiaryModal);

      // Drag and drop / click logic for diary photo
      if (diaryUploadZone && diaryPhotoInput) {
        diaryUploadZone.addEventListener('click', () => diaryPhotoInput.click());
        
        // Handle drag and drop
        diaryUploadZone.addEventListener('dragover', (e) => {
          e.preventDefault();
          diaryUploadZone.style.borderColor = 'var(--color-sage)';
          diaryUploadZone.style.backgroundColor = 'rgba(62, 86, 67, 0.05)';
        });
        
        diaryUploadZone.addEventListener('dragleave', () => {
          diaryUploadZone.style.borderColor = 'var(--color-border)';
          diaryUploadZone.style.backgroundColor = 'transparent';
        });
        
        diaryUploadZone.addEventListener('drop', (e) => {
          e.preventDefault();
          diaryUploadZone.style.borderColor = 'var(--color-border)';
          diaryUploadZone.style.backgroundColor = 'transparent';
          
          if (e.dataTransfer?.files && e.dataTransfer.files[0]) {
            diaryPhotoInput.files = e.dataTransfer.files;
            handleDiaryFile(e.dataTransfer.files[0]);
          }
        });
      }

      if (diaryPhotoInput) {
        diaryPhotoInput.addEventListener('change', () => {
          if (diaryPhotoInput.files && diaryPhotoInput.files[0]) {
            handleDiaryFile(diaryPhotoInput.files[0]);
          }
        });
      }

      function handleDiaryFile(file: File) {
        if (!file.type.startsWith('image/')) {
          alert('Please select an image file.');
          return;
        }
        const reader = new FileReader();
        reader.onload = () => {
          if (diaryPhotoPreview && diaryPreviewContainer && diaryUploadZone) {
            diaryPhotoPreview.src = reader.result as string;
            diaryPreviewContainer.style.display = 'block';
            diaryUploadZone.style.display = 'none';
          }
        };
        reader.readAsDataURL(file);
      }

      if (diaryRemovePhoto && diaryPhotoInput && diaryPreviewContainer && diaryUploadZone) {
        diaryRemovePhoto.addEventListener('click', (e) => {
          e.stopPropagation();
          diaryPhotoInput.value = '';
          diaryPreviewContainer.style.display = 'none';
          diaryUploadZone.style.display = 'flex';
          if (diaryUploadLabel) diaryUploadLabel.textContent = 'Click to select photo';
        });
      }

      if (diaryForm) {
        diaryForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const photoFile = diaryPhotoInput.files?.[0];
          if (!photoFile) {
            alert('Please select or drop a photo first.');
            return;
          }

          const reader = new FileReader();
          reader.onload = async () => {
            const base64Photo = reader.result;
            const captionInput = document.getElementById('diary-caption') as HTMLInputElement;
            const caption = captionInput ? captionInput.value : '';
            const slug = document.querySelector('main')?.getAttribute('data-recipe-slug') || '';

            try {
              const submitBtn = document.getElementById('diary-submit-btn') as HTMLButtonElement;
              submitBtn.disabled = true;
              submitBtn.textContent = 'Saving...';

              const res = await fetch('/api/diary', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ slug, photo: base64Photo, caption })
              });

              if (res.ok) {
                window.location.reload();
              } else {
                const errData = await res.json().catch(() => ({}));
                alert(errData.error || 'Failed to save diary entry.');
                submitBtn.disabled = false;
                submitBtn.textContent = 'Save Entry';
              }
            } catch (err) {
              console.error(err);
              alert('An error occurred while saving.');
              const submitBtn = document.getElementById('diary-submit-btn') as HTMLButtonElement;
              submitBtn.disabled = false;
              submitBtn.textContent = 'Save Entry';
            }
          };
          reader.readAsDataURL(photoFile);
        });
      }

      // === PREV / NEXT STEP NAVIGATION ===
      let currentStepIndex = 0;

      function renderInlineNavButtons(stepEl: Element, index: number) {
        // Remove existing nav if any
        const existingNav = stepEl.querySelector('.inline-step-nav');
        if (existingNav) existingNav.remove();

        const navContainer = document.createElement('div');
        navContainer.className = 'inline-step-nav';
        navContainer.style.cssText = 'display: flex; gap: 0.5rem; margin-top: 1rem; width: 100%; justify-content: flex-end;';

        if (index > 0) {
          const prevBtn = document.createElement('button');
          prevBtn.className = 'action-btn';
          prevBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg> Prev`;
          prevBtn.onclick = (e) => { e.stopPropagation(); goToStep(index - 1); };
          navContainer.appendChild(prevBtn);
        }

        const nextBtn = document.createElement('button');
        nextBtn.className = 'action-btn active';
        if (index >= allSteps.length - 1) {
          nextBtn.innerHTML = `Finish <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;
          nextBtn.onclick = (e) => { 
            e.stopPropagation(); 
            allSteps[index].classList.add('completed');
            allSteps[index].classList.remove('active');
            updateProgress();
            openDiaryModal();
          };
        } else {
          nextBtn.innerHTML = `Next <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>`;
          nextBtn.onclick = (e) => { e.stopPropagation(); goToStep(index + 1); };
        }
        navContainer.appendChild(nextBtn);
        
        // Append nav container inside the textSpan which is flex:1
        const textSpan = stepEl.querySelector('span:nth-child(2)');
        if (textSpan) textSpan.appendChild(navContainer);
      }

      function goToStep(index: number) {
        if (index < 0 || index >= allSteps.length) return;
        currentStepIndex = index;
        allSteps.forEach((s, i) => {
          s.classList.remove('active', 'completed');
          const existingNav = s.querySelector('.inline-step-nav');
          if (existingNav) existingNav.remove();
          
          if (i < index) s.classList.add('completed');
        });
        
        const activeStep = allSteps[currentStepIndex];
        activeStep.classList.add('active');
        renderInlineNavButtons(activeStep, currentStepIndex);
        
        // Scroll slightly above the active step so the user can see context
        const yOffset = -100;
        const y = activeStep.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: y, behavior: 'smooth' });
        
        updateProgress();
      }

      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          const isActive = document.body.classList.contains('cooking-mode-active');
          const doneSteps = instructionsCol ? instructionsCol.querySelectorAll('.interactive-step.completed').length : 0;
          
          if (isActive) {
            // Stopping cooking mode
            document.body.classList.remove('cooking-mode-active');
            toggleBtn.classList.remove('active');
            toggleBtn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/><polyline points="12 6 12 12 16 14"/></svg> Start Cooking`;
            
            if (doneSteps === totalSteps && totalSteps > 0) {
              openDiaryModal();
            }
            
            allSteps.forEach(s => {
              s.classList.remove('active', 'completed');
              const existingNav = s.querySelector('.inline-step-nav');
              if (existingNav) existingNav.remove();
            });
            currentStepIndex = 0;
            updateProgress();
          } else {
            // Starting cooking mode
            document.body.classList.add('cooking-mode-active');
            toggleBtn.classList.add('active');
            toggleBtn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg> Stop Cooking`;
            
            allSteps.forEach(s => {
              s.classList.remove('active', 'completed');
              const existingNav = s.querySelector('.inline-step-nav');
              if (existingNav) existingNav.remove();
            });
            currentStepIndex = 0;
            if (allSteps.length > 0) {
              allSteps[0].classList.add('active');
              renderInlineNavButtons(allSteps[0], 0);
              
              // Autoscroll to recipe directly
              const yOffset = -80;
              const y = instructionsCol.getBoundingClientRect().top + window.pageYOffset + yOffset;
              window.scrollTo({ top: y, behavior: 'smooth' });
            }
            updateProgress();
          }
        });
      }
    });
  </script>

