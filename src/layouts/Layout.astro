---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A beautiful, minimalist collection of curated recipes." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title} | The Modern Cookbook</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | The Modern Cookbook`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- PWA & Apple Web App Meta Tags -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="MyCookbook" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <header>
      <div class="logo">
        <a href="/">The Modern Cookbook</a>
      </div>
      <nav>
        <a href="/">All Recipes</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
