---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A personal collection of recipes, crafted for cooking." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title} | Sven's Cookbook</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | Sven's Cookbook`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Sven's Cookbook" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#3E5643" />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="site-logo" aria-label="Sven's Cookbook Home">
        <svg class="logo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" aria-hidden="true">
          <!-- Spoon -->
          <line x1="34" y1="6" x2="34" y2="38" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
          <ellipse cx="34" cy="10" rx="4" ry="5.5" stroke="currentColor" stroke-width="2.2" fill="none"/>
          <!-- Knife -->
          <line x1="26" y1="6" x2="26" y2="38" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
          <path d="M26 6 Q20 14 22 22 L26 22" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          <!-- Herb sprig -->
          <path d="M14 38 Q14 28 18 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/>
          <ellipse cx="12" cy="26" rx="4" ry="2.5" transform="rotate(-30 12 26)" fill="currentColor" opacity="0.7"/>
          <ellipse cx="20" cy="22" rx="4" ry="2.5" transform="rotate(20 20 22)" fill="currentColor" opacity="0.7"/>
          <ellipse cx="14" cy="32" rx="3.5" ry="2" transform="rotate(-15 14 32)" fill="currentColor" opacity="0.6"/>
        </svg>
        <div class="logo-text">
          <span class="logo-name">Sven's</span>
          <span class="logo-sub">Cookbook</span>
        </div>
      </a>
      <nav class="site-nav">
        <a href="/" class="nav-link">Recipes</a>
        <a href="/editor" class="nav-link nav-link--cta">+ Add Recipe</a>
      </nav>
    </header>
    <slot />
    <Footer />
  </body>
</html>
