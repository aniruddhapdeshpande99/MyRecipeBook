+            if (images.length > 0) openGalleryCarousel(images, 0);
+          } catch(e) {}
+        });
+      }
+
+      const diaryTriggers = document.querySelectorAll('.gallery-trigger');
+      const allDiaryImages = Array.from(diaryTriggers).map(t => ({
+        src: t.getAttribute('data-image') || '',
+        caption: t.getAttribute('data-caption') || ''
+      }));
+      
+      diaryTriggers.forEach((trigger, idx) => {
+        trigger.addEventListener('click', () => {
