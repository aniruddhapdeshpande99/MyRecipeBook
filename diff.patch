+      // === GALLERY CAROUSEL LOGIC ===
+      const galleryModal = document.getElementById('gallery-carousel-modal');
+      const galleryImg = document.getElementById('gallery-carousel-img') as HTMLImageElement;
+      const galleryCaption = document.getElementById('gallery-carousel-caption');
+      const galleryCloseBtn = document.getElementById('gallery-carousel-close');
+      const galleryPrevBtn = document.getElementById('gallery-carousel-prev');
+      const galleryNextBtn = document.getElementById('gallery-carousel-next');
+      
+      let currentGalleryImages: { src: string, caption: string }[] = [];
+      let currentGalleryIndex = 0;
+
+      function openGalleryCarousel(images: { src: string, caption: string }[], startIndex = 0) {
+        currentGalleryImages = images;
+        currentGalleryIndex = startIndex;
+        updateGalleryCarousel();
+        if (galleryModal) galleryModal.style.display = 'flex';
+        document.body.style.overflow = 'hidden';
+      }
+
+      function updateGalleryCarousel() {
+        if (!currentGalleryImages.length) return;
+        const current = currentGalleryImages[currentGalleryIndex];
+        if (galleryImg) galleryImg.src = current.src;
+        if (galleryCaption) galleryCaption.textContent = current.caption || '';
+        
+        if (galleryPrevBtn) galleryPrevBtn.style.visibility = currentGalleryIndex > 0 ? 'visible' : 'hidden';
+        if (galleryNextBtn) galleryNextBtn.style.visibility = currentGalleryIndex < currentGalleryImages.length - 1 ? 'visible' : 'hidden';
+      }
+
+      function closeGalleryCarousel() {
+        if (galleryModal) galleryModal.style.display = 'none';
+        document.body.style.overflow = '';
+        currentGalleryImages = [];
+      }
+
+      function nextGalleryImage() {
+        if (currentGalleryIndex < currentGalleryImages.length - 1) {
+          currentGalleryIndex++;
+          updateGalleryCarousel();
+        }
+      }
+
+      function prevGalleryImage() {
+        if (currentGalleryIndex > 0) {
+          currentGalleryIndex--;
+          updateGalleryCarousel();
+        }
+      }
+
+      if (galleryCloseBtn) galleryCloseBtn.addEventListener('click', closeGalleryCarousel);
+      if (galleryNextBtn) galleryNextBtn.addEventListener('click', (e) => { e.stopPropagation(); nextGalleryImage(); });
+      if (galleryPrevBtn) galleryPrevBtn.addEventListener('click', (e) => { e.stopPropagation(); prevGalleryImage(); });
+      if (galleryModal) {
+        galleryModal.addEventListener('click', (e) => {
+          if (e.target === galleryModal) closeGalleryCarousel();
+        });
+      }
+
+      document.addEventListener('keydown', (e) => {
+        if (galleryModal && galleryModal.style.display === 'flex') {
+          if (e.key === 'Escape') closeGalleryCarousel();
+          else if (e.key === 'ArrowRight') nextGalleryImage();
+          else if (e.key === 'ArrowLeft') prevGalleryImage();
+        }
+      });
+
